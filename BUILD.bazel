# =============================================================================
# MACRO TARGETS — full quality  (abstract_stage = cts)
# Used by the weekly GRT flow; CTS-level abstract needed for realistic timing.
# =============================================================================
[orfs_flow(
    name = "{TARGET_CFG}_{name}".format(
        name = name,
        TARGET_CFG = TARGET_CFG,
    ),
    # CTS abstract avoids gross clock-skew pessimism when timing is propagated to the top level
    abstract_stage = "cts",
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_MINIMUM_KEEP_SIZE": "10000",    # Keep modules >, flatten smaller modules
        "SYNTH_MEMORY_MAX_BITS": "65536",
        "CORE_UTILIZATION": "70",
        "CORE_MARGIN": "2",
    },
    # mock_area = 0.2  # Reduce size of the .lef area compared to SRAM implemented as flip-flops
    sources = {
        "SDC_FILE": [":bazel/constraints-sram.sdc"],
        "IO_CONSTRAINTS": [":sram_io_constraints"],
    },
    top = name + "_impl",
    verilog_files = ["bazel/srams/{TARGET_CFG}_{name}_impl.sv".format(
        name = name,
        TARGET_CFG = TARGET_CFG,
    )],
) for TARGET_CFG, srams in TARGET_CFGS.items() for name, config in srams.items()]


# =============================================================================
# TOP-LEVEL TARGETS — full quality
