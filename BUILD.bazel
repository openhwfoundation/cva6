# =============================================================================
# MACRO TARGETS — fast variant  (abstract_stage = place)
# Used by the per-push floorplan CI flow.  A post-placement timing model is
# sufficient because the top-level itself only reaches floorplan stage, where
# fmax / stdcell_area metrics are synthesis-derived regardless.
# =============================================================================
[orfs_flow(
    name = "{TARGET_CFG}_{name}_fast".format(
        name = name,
        TARGET_CFG = TARGET_CFG,
    ),
    # post-placement abstract; skips CTS, accurate enough when top-level stops at floorplan
    abstract_stage = "place",
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_MINIMUM_KEEP_SIZE": "10000",    # Keep modules >, flatten smaller modules
        "SYNTH_MEMORY_MAX_BITS": "65536",
        "CORE_UTILIZATION": "70",
        "CORE_MARGIN": "2",
    },
    sources = {
        "SDC_FILE": [":bazel/constraints-sram.sdc"],
        "IO_CONSTRAINTS": [":sram_io_constraints"],
    },
    top = name + "_impl",
    verilog_files = ["bazel/srams/{TARGET_CFG}_{name}_impl.sv".format(
        name = name,
        TARGET_CFG = TARGET_CFG,
    )],
) for TARGET_CFG, srams in TARGET_CFGS.items() for name, config in srams.items()]


# =============================================================================
# TOP-LEVEL TARGETS — fast variant
# Targets for the per-push floorplan CI flow (//:cv32a65x_fast_floorplan, etc.).
# Depend on the floorplan-abstract macros; saves significant runtime since
# macros stop before CTS.  Floorplan metrics (area, WNS) are unaffected.
# =============================================================================
[orfs_flow(
    name = TARGET_CFG + "_fast",
    top = "cva6",           # top-level Verilog module name
    macros = ["{TARGET_CFG}_{name}_fast_generate_abstract".format(
        name = name,
        TARGET_CFG = TARGET_CFG,
    ) for name in srams.keys()],
    sources = {
        "SDC_FILE": [":bazel/constraints.sdc"],
        "PDN_TCL": ["bazel/pdn.tcl"],  # Custom PDN ignoring mock macros
    },
    arguments = {
        # Synthesis
        "SYNTH_HIERARCHICAL": "1",             # Flat synthesis
        "SYNTH_MINIMUM_KEEP_SIZE": "10000",    # Keep modules >, flatten smaller modules
        "ABC_CLOCK_PERIOD_IN_PS": "4000",      # 250 MHz for Yosys ABC
        "SYNTH_MEMORY_MAX_BITS": "65536",
        "SYNTH_HDL_FRONTEND": "slang",         # Modern SV compiler
        "VERILOG_DEFINES": "-D HPDCACHE_ASSERT_OFF",  # Disables HPDcache asserts
        "VERILOG_INCLUDE_DIRS": " ".join([     # slang include paths
            "core/include",
            "core/cache_subsystem/hpdcache/rtl/include",
            "vendor/pulp-platform/common_cells/include",
            "vendor/pulp-platform/common_cells/src",
            "vendor/pulp-platform/axi/include",
            "common/local/util",
        ]),

        # Floorplan
        "CORE_UTILIZATION": "70",             # 70% core area
        "CORE_MARGIN": "2",                   # 2µm margin
        "MACRO_PLACE_HALO": "3 3",            # 3µm around macros

        # Placement
