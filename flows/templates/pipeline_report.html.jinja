       ${jobHeaderMeta(j)}`, j);
  }
  return eagerCard(sectionHead(worstStatus(jobs), title), jobs.map(jobEntry).join(""));
}
/* Section card with named subsections (e.g. Helloworld: Compilation /
 * Run simulation). Empty subsections are hidden. Subsections marked
 * infoOnly (e.g. Spike) are shown but excluded from the header status. */
function groupCard(title, subs) {
  const all = subs.flatMap(([, js]) => js);
  if (!all.length) return plainCard(sectionHead(null, title));
  const statusJobs = subs.filter(([, , infoOnly]) => !infoOnly).flatMap(([, js]) => js);
  const body = subs.filter(([, js]) => js.length)
                   .map(([st, js]) => jobsCard(st, js)).join("");
  return eagerCard(
    sectionHead(statusJobs.length ? worstStatus(statusJobs) : worstStatus(all), title),
    body);
}
/* --- testlists: one card per testlist, then one card per test with
 * Compilation / Run simulation sub-cards (child reports) ------------- */
function testlistName(j) {
  const tl = (j.context && j.context.testlist) || "";
  return tl ? tl.split("/").pop().replace(/\.[^.]*$/, "") : "custom";
}
function entryStatus(e) {  /* per-test comp/run entry: doc wins over row */
  if (e.doc && e.doc.status === "pass" && e.doc.context && e.doc.context.tandem_mismatch)
    return "pass-tandem";
  return (e.doc && e.doc.status) || e.status;
}
function testlistTests(jobs) {  /* test name -> {comp: {status, doc}, run: ...} */
  const tests = new Map();
  for (const j of jobs) {
    const kind = j._class === "testlist_comp" ? "comp" : "run";
    for (const m of j.metrics || []) {
      if (m.kind !== "rows") continue;
      for (const r of m.data || []) {
        if (!r.test) continue;
        const key = childKeyFor(j, r.report);
        if (!tests.has(r.test)) tests.set(r.test, {});
        tests.get(r.test)[kind] = {
          status: String(r.status || "").toLowerCase(),
          doc: key ? j.children[key] : null,
        };
      }
    }
  }
  return tests;
}
function testlistCards(jobs) {
  const tlJobs = jobs.filter((j) => ["testlist_comp", "testlist_run"].includes(j._class));
  if (!tlJobs.length) return plainCard(sectionHead(null, "Testlists"));
  const groups = new Map();  /* testlist name -> jobs[] */
  for (const j of tlJobs) {
    const n = testlistName(j);
    if (!groups.has(n)) groups.set(n, []);
    groups.get(n).push(j);
  }
  let html = "";
  for (const [name, js] of groups) {
    const tests = testlistTests(js);
    let body = "";
    for (const [test, e] of tests) {
      const parts = [];
      if (e.comp) parts.push(["Compilation", e.comp]);
      if (e.run) parts.push(["Run simulation", e.run]);
      const worst = worstOf(parts.map(([, x]) => entryStatus(x)));
      const sub = parts.map(([st, x]) => {
        const head = sectionHead(entryStatus(x), st);
        return x.doc ? lazyChildCard(head, x.doc) : plainCard(head);
      }).join("");
      body += eagerCard(`${badge(worst)} <span class="mono small">${esc(test)}</span>`, sub);
    }
    /* The reports of the testlist jobs themselves are not repeated: their
     * rows are the tests listed above. A test only shows up when its
     * compilation or run recorded it, so a job that stopped before its
     * first test gets its report listed instead, for its error. */
    if (!tests.size) body += js.map(jobEntry).join("");
    html += eagerCard(
      sectionHead(worstStatus(js), `Testlist: ${name}`,
        `<span class="text-muted small ms-auto">${tests.size} tests</span>`),
      body);
  }
  return html;
}
/* Static per-target topology: compact collapsed cards, in this order.
 * Main sections are always shown (— badge when empty); Post simulation
 * and Other only when they have results. */
function targetSections(jobs) {
  const by = (...cls) => jobs.filter((j) => cls.includes(j._class));
  let html = "";
  html += jobsCard("Spyglass", by("spyglass"));
  html += jobsCard("RTL elaboration", by("rtl_elab"));
  html += groupCard("Helloworld", [
    ["Compilation", by("hello_comp")],
    ["Run simulation", by("hello_run")],
    ["Run simulation — stalling memory", by("hello_run_stall")],
    ["TestHarness VCS — elaboration", by("th_vcs_elab")],
    ["TestHarness VCS — run simulation", by("th_vcs_run")],
    ["TestHarness Verilator — elaboration", by("th_elab")],
    ["TestHarness Verilator — run simulation", by("th_run")],
    ["Spike — Run simulation", by("spike"), true]]);
  html += testlistCards(jobs);
  html += groupCard("Coremark", [
    ["Compilation", by("coremark_comp")],
    ["Run simulation", by("coremark_run")]]);
  html += groupCard("Dhrystone", [
    ["Compilation", by("dhrystone_comp")],
    ["Run simulation", by("dhrystone_run")]]);
  html += jobsCard("Synthesis", by("synthesis"));
  html += jobsCard("Documentation", by("docs"));
  html += groupCard("FPGA", [
    ["Bootloader compilation", by("fpga_bootrom_comp")],
    ["Bootloader", by("fpga_bootrom")],
    ["Bitstream", by("fpga_build")],
    ["Board programming", by("fpga_program")],
    ["Linux boot", by("fpga_boot")]]);
  const post = [["Netlist elaboration", by("postsim_elab")],
                ["Netlist run simulation", by("postsim_run")]];
  if (post.some(([, js]) => js.length)) html += groupCard("Post simulation", post);
  const placedCls = ["spyglass", "rtl_elab", "hello_comp", "spike", "hello_run",
    "hello_run_stall", "th_vcs_elab", "th_vcs_run", "th_elab", "th_run",
    "testlist_comp", "testlist_run", "coremark_comp", "coremark_run",
    "dhrystone_comp", "dhrystone_run", "synthesis", "docs",
    "fpga_bootrom_comp", "fpga_bootrom", "fpga_build", "fpga_program", "fpga_boot",
    "postsim_elab", "postsim_run"];
  const leftover = jobs.filter((j) => !placedCls.includes(j._class));
  if (leftover.length) {
    html += eagerCard(sectionHead(worstStatus(leftover), "Other"),
                      leftover.map(jobEntry).join(""));
  }
  return html;
}
(function renderDetails() {
  let html = "";
  for (const t of TARGETS) {
    const jobs = TARGET_JOBS.get(t);
    const cid = `card-${t}`.replace(/[^\w-]/g, "_");
    const nPass = jobs.filter((j) => j.status === "pass").length;
    const donut = donutJob(t);
    html += `
    <div class="card shadow-sm mb-2">
      <div class="card-header clickable d-flex flex-wrap align-items-center gap-2"
           data-bs-toggle="collapse" data-bs-target="#${cid}">
        ${badge(worstStatus(jobs))}
        <span class="fw-bold mono" style="word-break: break-all">${esc(t)}</span>
        ${configTags(t)}
        <span class="text-muted small ms-auto">${nPass}/${jobs.length} jobs</span>
      </div>
      <div class="collapse" id="${cid}" data-target-name="${esc(t)}">
        <div class="card-body">
          ${targetIssues(t)}
          ${docLinks(t)}
          <div class="d-flex flex-wrap gap-4 align-items-start mb-2">
            <div>${kpiBlock(t)}</div>
            ${donut ? `<div class="donut-box flex-grow-1">
               <canvas data-donut-job="${donut._idx}"></canvas></div>` : ""}
          </div>
          ${rtlConfigDetails(t)}
          ${t === CROSS_TARGET
            ? `<h6 class="mt-2">Jobs</h6>${jobs.map(jobEntry).join("")}`
            : targetSections(jobs)}
        </div>
      </div>
    </div>`;
  }
  document.getElementById("target-details").innerHTML = html;
})();

/* =====================================================================
 * LAZY RENDERING — bootstrap collapse events bubble to the document
 * ===================================================================== */
document.addEventListener("show.bs.collapse", (ev) => {
  const el = ev.target;
  if (el.dataset.rendered) return;
  if (el.dataset.jobIdx !== undefined) {
    el.dataset.rendered = "1";
    el.querySelector(".lazy-slot").innerHTML = renderMetrics(JOBS[+el.dataset.jobIdx]);
  } else if (el.dataset.childId !== undefined) {
    el.dataset.rendered = "1";
    el.querySelector(".lazy-slot").innerHTML = renderMetrics(CHILD_REG[el.dataset.childId]);
  }
});
/* Donut on first target expansion (Chart.js renders poorly in display:none) */
document.addEventListener("shown.bs.collapse", (ev) => {
  const el = ev.target;
  if (el.dataset.targetName === undefined) return;
  const canvas = el.querySelector("[data-donut-job]:not([data-rendered])");
  if (!canvas) return;
  canvas.dataset.rendered = "1";
  const job = JOBS[+canvas.dataset.donutJob];
  const m = (job.metrics || []).find((x) => x.name === "Hierarchies details");
  /* A synthesis on a techno gives an area in kGates; the GTECH one has
   * no area and gives cell counts instead */
  const cells = m.data.length && m.data[0].kcells !== undefined;
  const unit = cells ? "kCells" : "kGates";
  const datasets = cells ? hierRings(m.data)
    : [{ data: m.data.map((r) => r.kgates), names: m.data.map((r) => moduleName(r.hierarchy)),
         backgroundColor: DONUT_COLORS }];
  new Chart(canvas, {
    type: "doughnut",
    data: { labels: datasets[0].names, datasets },
    options: {
      /* The slices are named by the tooltip: a legend of every block
       * would squeeze the chart */
      legend: { display: false },
      cutoutPercentage: cells ? 20 : 50,
      title: {
        display: true,
        text: cells ? "Cells per hierarchy (kCells, GTECH), one ring per level"
                    : "Area per hierarchy (kGates)",
      },
      tooltips: {
        filter: (item, data) => data.datasets[item.datasetIndex].names[item.index] !== "",
        callbacks: {
          label: (item, data) => {
            const ds = data.datasets[item.datasetIndex];
            return `${ds.names[item.index]}: ${ds.data[item.index]} ${unit}`;
          },
        },
      },
    },
  });
});
/* Click on a matrix row: open and scroll to the target details. A link
 * inside the row keeps its own behaviour, which without this would also
 * expand the card below. */
document.querySelectorAll("#matrix tr[data-target]").forEach((row) => {
  row.addEventListener("click", (event) => {
    if (event.target.closest("a")) return;
    const cid = `card-${row.dataset.target}`.replace(/[^\w-]/g, "_");
    const card = document.getElementById(cid);
    if (!card) return;
    bootstrap.Collapse.getOrCreateInstance(card).show();
    card.closest(".card").scrollIntoView({ behavior: "smooth", block: "start" });
  });
});
