      data: segments.map((s) => s.value),
      names: segments.map((s) => (s.path ? moduleName(s.path) : "")),
      backgroundColor: segments.map((s) => (s.path ? colour(s.path) : "rgba(0,0,0,0)")),
      borderWidth: 1,
