+   // An atomic transaction is split in two halves handled by independent entry
+   // points: write_data() waits for the value read from memory, read_data()
+   // provides it. A SystemVerilog event is not persistent, so if read_data()
+   // triggered it before write_data() reached the wait, the notification was
+   // lost and write_data() blocked forever, leaving the write without its B
+   // response. The data is therefore kept in a persistent store, indexed by
+   // AXI ID so that several atomics can be in flight, and the waiting side
+   // polls that store instead of an event.
+   local longint atomic_read_data[int];
+   local bit     atomic_read_valid[int];
 
