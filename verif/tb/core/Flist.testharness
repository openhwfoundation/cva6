// Sources of the TestHarness testbench, read next to the Flist.cva6 of
// the target and shared by the four simulators driving it.
//
// counter.sv, fifo_v3.sv and lzc.sv are left out: the target filelist
// declares a module of the same name, and analysing two of them is an
// error for the event-driven simulators. Verilator accepts it, taking
// whichever comes last.

// SoC and peripheral RTL

// Include directories of the harness and of the RTL it instantiates.
+incdir+${CVA6_REPO_DIR}/core/include
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/common_cells/include
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/axi/include
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/obi/include
+incdir+${CVA6_REPO_DIR}/corev_apu/register_interface/include
+incdir+${CVA6_REPO_DIR}/corev_apu/tb/common
+incdir+${CVA6_REPO_DIR}/corev_apu/instr_tracing/ITI/include
+incdir+${CVA6_REPO_DIR}/corev_apu/axi_node
+incdir+${CVA6_REPO_DIR}/verif/tb/core
+incdir+${CVA6_REPO_DIR}/verif/core-v-verif/lib/uvm_agents/uvma_rvfi
+incdir+${CVA6_REPO_DIR}/verif/core-v-verif/lib/uvm_agents/uvma_core_cntrl
+incdir+${CVA6_REPO_DIR}/verif/core-v-verif/lib/uvm_components/uvmc_rvfi_reference_model
+incdir+${CVA6_REPO_DIR}/verif/core-v-verif/lib/uvm_components/uvmc_rvfi_scoreboard
+incdir+${SPIKE_INSTALL_DIR}/include/disasm

